APP_NAME=SpectBloom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# La conexión a la base de datos (DB_*) la define docker-compose.yml

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Login con Google (pon aquí los mismos valores que teníais en Laragon)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# IA (Ollama). El frontend pide el modelo "mistral"
OLLAMA_DEFAULT_MODEL=mistral
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.7
